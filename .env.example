# Copy to .env (repo root) and edit as needed.
API_DB_URL=postgresql+psycopg://flow:flow@127.0.0.1:5433/flowdb
API_BASE_URL=http://127.0.0.1:8000
# Optional legacy fallback; frontend now proxies backend calls through /api/backend.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Supabase auth (frontend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
POLY_KEY=
AV_KEY=
SEC_USER_AGENT=Your Name your.email@example.com
NASDAQ_BURST_PER_SECOND=0.5
POLYGON_BURST_PER_SECOND=0.2
ALPHAVANTAGE_BURST_PER_SECOND=0.08
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=20000

# Remote demo subset push (Supabase Postgres target)
DEMO_REMOTE_DB_URL=
DEMO_TOP_N=7
DEMO_QUARTERS=2
DEMO_BO_KEEP_DAYS=180
DEMO_INSIDER_KEEP_DAYS=120
DEMO_SYNC_BATCH_SIZE=5000
DEMO_RUN_LOCAL_UPDATES=0
DEMO_SKIP_SCHEMA_INIT=0
DEMO_DRY_RUN=0

# AI chat (OpenAI-style API; works with OpenAI or LM Studio-compatible servers)
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.1
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_STEPS=6
AI_SQL_FALLBACK_ENABLED=false
AI_MAX_OUTPUT_TOKENS=700
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_MESSAGE_CHARS=2000
AI_TOOL_RESULT_MAX_CHARS=1800
